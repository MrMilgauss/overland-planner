# Overland route planner settings for deploy/compose.yaml. Copy to deploy/.env (or pass --env-file .env) and edit;
# the real .env is never committed and never enters the image. No secret values here.

# Address the planner is published on. Required: compose refuses to start without it.
# 127.0.0.1 = this machine only; on the Pi use its home-network address (its address on the home network). Never 0.0.0.0.
PLANNER_BIND=127.0.0.1
# Host port (container port is always 8080).
PLANNER_PORT=8080

# Planner log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Optimizer search budget (positive integer).
SOLVER_BUDGET=10000
# Solve limits, whole seconds from pressing Calculate. Without a valid route by FEASIBILITY_LIMIT_S the run fails
# (timeout); with one, the search ends at OPTIMISATION_LIMIT_S with the best plan so far. Feasibility <= optimisation.
FEASIBILITY_LIMIT_S=600
OPTIMISATION_LIMIT_S=1800

# Shared household password (HTTP Basic). Set both or neither; empty = no password asked.
PLANNER_BASIC_AUTH_USER=
PLANNER_BASIC_AUTH_PASSWORD=

# Trail upload caps (positive integers; MB = MiB): per file, per request, files per request. A request above a cap
# answers 413. Empty = the default shown in the comment.
MAX_UPLOAD_FILE_MB=
MAX_UPLOAD_REQUEST_MB=
MAX_UPLOAD_FILES=
# Defaults: MAX_UPLOAD_FILE_MB 25, MAX_UPLOAD_REQUEST_MB 100, MAX_UPLOAD_FILES 50.

# Written by deploy.sh into release.env, not here: the image to run.
# PLANNER_IMAGE=ghcr.io/mrmilgauss/overland-planner@sha256:...

# Set by make perf-pi for planner-perf only (profile perf), not here: I2's road map while its golden order is checked.
# PERF_MOCK_PLAN=/perf/i2-sparse.road-map.yaml

# Routing engine (profile routing, compose.yaml): the tileset VALHALLA_TILESET comes from routing.env, written by
# make tiles-seed; VALHALLA_IMAGE overrides the pinned arm64 image (an amd64 PC needs its own).
# VALHALLA_TILESET=none
# VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:3.9.1-arm64@sha256:...

# Fixed by compose.yaml or the image; listed for reference, do not set:
# DATA_DIR=/data
# ROUTING_PROVIDER=mock
# MOCK_PLAN=<path of a scripted offline road map (YAML, brief section 6); tests and development only>
# WEB_DIST_DIR=/app/web/dist
# MIGRATIONS_DIR=/app/migrations
# PLANNER_GIT_SHA=<commit of the image>

# Rollback drill release B (slice 00b gate, 2026-11-03).
# Rollback drill release C (slice 00b gate, 2026-11-03).

# Overland route planner settings for deploy/compose.yaml. Copy to deploy/.env (or pass --env-file .env) and edit;
# the real .env is never committed and never enters the image. No secret values here.

# Address the planner is published on. Required: compose refuses to start without it.
# 127.0.0.1 = this machine only; on the Pi use its home-network address (its address on the home network). Never 0.0.0.0.
PLANNER_BIND=127.0.0.1
# Host port (container port is always 8080).
PLANNER_PORT=8080

# Planner log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Optimizer search budget (positive integer).
SOLVER_BUDGET=10000
# Solve limits, whole seconds from pressing Calculate. Without a valid route by FEASIBILITY_LIMIT_S the run fails
# (timeout); with one, the search ends at OPTIMISATION_LIMIT_S with the best plan so far. Feasibility <= optimisation.
FEASIBILITY_LIMIT_S=600
OPTIMISATION_LIMIT_S=1800

# Shared household password (HTTP Basic). Set both or neither; empty = no password asked.
PLANNER_BASIC_AUTH_USER=
PLANNER_BASIC_AUTH_PASSWORD=

# Trail upload caps (positive integers; MB = MiB): per file, per request, files per request. A request above a cap
# answers 413. Empty = the default shown in the comment.
MAX_UPLOAD_FILE_MB=
MAX_UPLOAD_REQUEST_MB=
MAX_UPLOAD_FILES=
# Defaults: MAX_UPLOAD_FILE_MB 25, MAX_UPLOAD_REQUEST_MB 100, MAX_UPLOAD_FILES 50.

# Written by deploy.sh into release.env, not here: the image to run.
# PLANNER_IMAGE=ghcr.io/mrmilgauss/overland-planner@sha256:...

# Set by make perf-pi for planner-perf only (profile perf), not here: I2's road map while its golden order is checked.
# PERF_MOCK_PLAN=/perf/i2-sparse.road-map.yaml
# Set by make perf-pi MODE=e2e and make acceptance-pi for planner-perf only: `valhalla` = the live engine (D236).
# PERF_ROUTING_PROVIDER=valhalla

# Routing engine (profile routing, compose.yaml): the tileset VALHALLA_TILESET comes from routing.env, written by
# make tiles-seed; VALHALLA_IMAGE overrides the pinned arm64 image (an amd64 PC needs its own).
# VALHALLA_TILESET=none
# VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:3.9.1-arm64@sha256:...
# Memory cap of the tile build (valhalla-build, profile valhalla-build; default 9g).
# VALHALLA_BUILD_MEM=9g

# The planner's road map (D247): `mock` (default, offline) or `valhalla` (real roads from the engine above). Restart the
# planner after changing it. The planner starts even when the engine is down; /api/health says so.
# ROUTING_PROVIDER=valhalla
# Engine tuning, normally left unset (defaults: expected engine version 3.9.1, 2500 matrix cells per call, 2 calls at a
# time, 250 m snap distance for a confirmed point).
# VALHALLA_EXPECTED_VERSION=3.9.1
# VALHALLA_MAX_MATRIX_PAIRS=2500
# VALHALLA_CONCURRENCY=2
# CONFIRMED_SNAP_M=250

# The map's tiles (ADR-004), normally left unset: OpenTopoMap, always credited. MAP_TILE_URL is a raster tile address
# with {z}, {x} and {y}; one that carries a key, token or similar parameter is refused at start-up (the .env of a
# repository checkout is not the place for a private key). MAP_TILE_MAX_ZOOM is 1 to 22.
# MAP_TILE_URL=https://tile.opentopomap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=Map data: © OpenStreetMap contributors, SRTM | Map style: © OpenTopoMap (CC-BY-SA)
# MAP_TILE_MAX_ZOOM=17
# The light base map (ADR-004 Amendment 1), normally left unset: OpenFreeMap "Positron", no key, always credited.
# MAP_BASE_STYLE_URL is a style address; the same key guard as MAP_TILE_URL applies (no placeholders needed).
# MAP_BASE_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# MAP_BASE_ATTRIBUTION=© OpenFreeMap © OpenMapTiles © OpenStreetMap contributors
# Place search (slice 12c): the Add menu's "Search for a place". PLACE_SEARCH is on or off (empty means on); off removes it.
# PLACE_SEARCH_URL is the search service's address, normally left unset: the public Nominatim service, whose usage
# policy (https://operations.osmfoundation.org/policies/nominatim/) the planner follows. A leftover ROAD_MAP_AREA line is ignored.
# The policy record is docs/product/architecture/adr-019-place-search-proxy-nominatim.md (only the typed words are sent).
# PLACE_SEARCH=on
# PLACE_SEARCH_URL=https://nominatim.openstreetmap.org/search
# The road map's regions (slice 12c, D301, D316). compose.yaml fixes both folders for the planner on the Pi, so leave
# them unset there: ROAD_MAP_DIR is /valhalla-data/tilesets (the engine's volume, read-only) and ROAD_MAP_CHANGES_DIR is
# /road-map-changes (the planned changes the Pi's helper takes). Outside compose, empty means unknown / no changes.
# ROAD_MAP_DIR=
# ROAD_MAP_CHANGES_DIR=
# The free list of regions the owner searches when changing the road map (D306): Geofabrik's index, normally left
# unset (empty means this default). Only this address's own server is ever asked about a region. A mirror needs both
# this and ROAD_MAP_DOWNLOAD_PREFIX, on one and the same origin.
# GEOFABRIK_INDEX_URL=https://download.geofabrik.de/index-v1-nogeom.json
# Read by the Pi's road-map helper only (the planner never sees it and compose does not pass it):
# the address every region download must start with, normally left unset (https://download.geofabrik.de/).
# One-origin rule: with a mirror, GEOFABRIK_INDEX_URL and ROAD_MAP_DOWNLOAD_PREFIX both name that mirror, or neither.
# ROAD_MAP_DOWNLOAD_PREFIX=https://download.geofabrik.de/
# The most map data, in GB, a road-map change may download; the default is set by the planner (empty means 8).
# ROAD_MAP_MAX_GB=
# Test and demo setups with the mock engine only: the map set to treat as served. Refused with ROUTING_PROVIDER=valhalla.
# ROAD_MAP_SERVED_TILESET=

# Fixed by compose.yaml or the image; listed for reference, do not set:
# DATA_DIR=/data
# VALHALLA_URL=http://valhalla:8002
# MOCK_PLAN=<path of a scripted offline road map (YAML, brief section 6); tests and development only>
# WEB_DIST_DIR=/app/web/dist
# MIGRATIONS_DIR=/app/migrations
# PLANNER_GIT_SHA=<commit of the image>

# Rollback drill release B (slice 00b gate, 2026-11-03).
# Rollback drill release C (slice 00b gate, 2026-11-03).

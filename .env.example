# Overland route planner settings for deploy/compose.yaml. Copy to deploy/.env (or pass --env-file .env) and edit;
# the real .env is never committed and never enters the image. No secret values here.

# Address the planner is published on. Required: compose refuses to start without it.
# 127.0.0.1 = this machine only; on the Pi use its home-network address (192.168.1.10). Never 0.0.0.0.
PLANNER_BIND=127.0.0.1
# Host port (container port is always 8080).
PLANNER_PORT=8080

# Planner log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Optimizer search budget (positive integer).
SOLVER_BUDGET=10000

# Shared household password (HTTP Basic). Set both or neither; empty = no password asked.
PLANNER_BASIC_AUTH_USER=
PLANNER_BASIC_AUTH_PASSWORD=

# Written by deploy.sh into release.env, not here: the image to run.
# PLANNER_IMAGE=ghcr.io/mrmilgauss/overland-planner@sha256:...

# Fixed by compose.yaml or the image; listed for reference, do not set:
# DATA_DIR=/data
# ROUTING_PROVIDER=mock
# WEB_DIST_DIR=/app/web/dist
# MIGRATIONS_DIR=/app/migrations
# PLANNER_GIT_SHA=<commit of the image>

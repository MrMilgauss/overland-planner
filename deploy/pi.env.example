# Copy to deploy/pi.env (git-ignored) and put the real values there. `make deploy`, `make perf-pi`, `make status` and the
# other Pi targets read it; a PI_HOST given on the make command line wins over the file.
#
# ssh login of the deploy user on the Pi (BatchMode: passwordless ssh must already work).
PI_HOST=deploy@pi.example
# Install directory on the Pi, relative to that user's home.
PI_DIR=apps/overland-planner
# Address the planner answers on once deployed (the home-network address of the Pi and PLANNER_PORT).
PLANNER_URL=http://192.168.1.10:8080/

{
  "components": {
    "schemas": {
      "AnchorsChoice": {
        "description": "The Start and End item ids (HC-2): POIs of the project, the same one for a round trip. Both required in 01a.",
        "properties": {
          "end_item_id": {
            "title": "End Item Id",
            "type": "string"
          },
          "start_item_id": {
            "title": "Start Item Id",
            "type": "string"
          }
        },
        "required": [
          "start_item_id",
          "end_item_id"
        ],
        "title": "AnchorsChoice",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "Every non-2xx answer under /api (D183).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ItemResource": {
        "description": "A catalog item (D107): `location` for a POI; `entry`, `exit` and `length_m` for a track; others null.",
        "properties": {
          "anchor": {
            "anyOf": [
              {
                "enum": [
                  "start",
                  "end",
                  "start_end"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchor"
          },
          "entry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "included": {
            "title": "Included",
            "type": "boolean"
          },
          "length_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Length M"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "enum": [
              "track",
              "poi"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "included",
          "anchor",
          "location",
          "entry",
          "exit",
          "length_m"
        ],
        "title": "ItemResource",
        "type": "object"
      },
      "PlanRunResource": {
        "description": "A numbered plan run; a job still running has none.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ready",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "status"
        ],
        "title": "PlanRunResource",
        "type": "object"
      },
      "PoiCreate": {
        "description": "A place by decimal degrees. The ranges are the domain's rule (D151 reasons), so they are not checked here.",
        "properties": {
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "lat",
          "lon"
        ],
        "title": "PoiCreate",
        "type": "object"
      },
      "PointResource": {
        "properties": {
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "PointResource",
        "type": "object"
      },
      "ProjectCreate": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectCreate",
        "type": "object"
      },
      "ProjectResource": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "revision"
        ],
        "title": "ProjectResource",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Overland Route Planner",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {

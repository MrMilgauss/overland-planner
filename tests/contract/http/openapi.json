      "get": {
        "description": "The stops in order, track stops with their entry and exit; a Failed run has no stops and names its reason.",
        "operationId": "plan_run_api_plan_runs__plan_run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "plan_run_id",
            "required": true,
            "schema": {
              "title": "Plan Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanRunDetailResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "not_found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"

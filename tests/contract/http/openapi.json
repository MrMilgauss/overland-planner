              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Plan Run"
      }
    },
    "/api/plan-runs/{plan_run_id}/export.gpx": {
      "get": {
        "description": "Changes nothing. 404 `not_found` for an unknown run; 422 `validation_error` when a track's stored points are\nnot the ones the run recorded. A sync handler, so a big track never holds up the event loop.",
        "operationId": "export_gpx_api_plan_runs__plan_run_id__export_gpx_get",
        "parameters": [
          {
            "in": "path",
            "name": "plan_run_id",
            "required": true,
            "schema": {
              "title": "Plan Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/gpx+xml": {}
            },
            "description": "The GPX file"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "not_found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Export Gpx"
      }
    },

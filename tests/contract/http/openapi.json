{
  "components": {
    "schemas": {
      "AnchorsChoice": {
        "description": "The Start and End item ids (HC-2): POIs of the project, one POI for both on a round trip; `null` unsets one.",
        "properties": {
          "end_item_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Item Id"
          },
          "start_item_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Item Id"
          }
        },
        "required": [
          "start_item_id",
          "end_item_id"
        ],
        "title": "AnchorsChoice",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "Every non-2xx answer under /api (D183).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ItemResource": {
        "description": "A catalog item (D107): `location` for a POI; `entry`, `exit` and `length_m` for a track; others null.",
        "properties": {
          "anchor": {
            "anyOf": [
              {
                "enum": [
                  "start",
                  "end",
                  "start_end"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchor"
          },
          "entry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "included": {
            "title": "Included",
            "type": "boolean"
          },
          "length_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Length M"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "enum": [
              "track",
              "poi"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "included",
          "anchor",
          "location",
          "entry",
          "exit",
          "length_m"
        ],
        "title": "ItemResource",
        "type": "object"
      },
      "PlanJobAccepted": {
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "title": "PlanJobAccepted",
        "type": "object"
      },
      "PlanJobResource": {
        "description": "The poll payload (brief \u00a75): the subset filled so far; later fields are additive. `memo_hit` is false until the\nmemo (05-10).",
        "properties": {
          "elapsed_s": {
            "title": "Elapsed S",
            "type": "number"
          },
          "ignore_memo": {
            "title": "Ignore Memo",
            "type": "boolean"
          },
          "memo_hit": {
            "title": "Memo Hit",
            "type": "boolean"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "plan_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Run Id"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "state": {
            "enum": [
              "queued",
              "computing_legs",
              "waiting_for_optimizer",
              "solving",
              "finalising",
              "done",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "reason",
          "message",
          "plan_run_id",
          "elapsed_s",
          "memo_hit",
          "ignore_memo"
        ],
        "title": "PlanJobResource",
        "type": "object"
      },
      "PlanReportResource": {
        "description": "Why a Failed run has no plan, in product words (D206); the code stays in `failure_reason`.",
        "properties": {
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "PlanReportResource",
        "type": "object"
      },
      "PlanRunDetailResource": {
        "description": "A plan run with its ordered stops and totals; a Failed run has neither, names its `failure_reason` and keeps the\nreason in product words in `report`. A ready run shows `report` null, as does any run stored before 05-08; a run\nstored before the totals were (0006) shows `totals` null.",
        "properties": {
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string"
          },
          "report": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanReportResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ready",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/PlanStopResource"
            },
            "title": "Stops",
            "type": "array"
          },
          "totals": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TotalsResource"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "project_id",
          "number",
          "status",
          "failure_reason",
          "stops",
          "totals",
          "report"
        ],
        "title": "PlanRunDetailResource",
        "type": "object"
      },
      "PlanRunResource": {
        "description": "A numbered plan run; a job still running has none. `stale`: the project changed since it was computed.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ready",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "status",
          "stale"
        ],
        "title": "PlanRunResource",
        "type": "object"
      },
      "PlanStopResource": {
        "description": "One stop of the itinerary (FR-6.1): the first has no road leg; a track shows its entry and exit (HC-1), its\nlength and off-road time, a POI none. Km and seconds are unrounded; a run stored before them shows them null.",
        "properties": {
          "cumulative_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cumulative Km"
          },
          "cumulative_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cumulative S"
          },
          "entry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "leg_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leg Km"
          },
          "leg_s": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leg S"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "offroad_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Offroad S"
          },
          "track_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Km"
          },
          "type": {
            "enum": [
              "poi",
              "track"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "leg_km",
          "entry",
          "exit",
          "leg_s",
          "track_km",
          "offroad_s",
          "cumulative_km",
          "cumulative_s"
        ],
        "title": "PlanStopResource",
        "type": "object"
      },
      "PoiCreate": {
        "description": "A place by decimal degrees. The ranges are the domain's rule (D151 reasons), so they are not checked here.",
        "properties": {
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "lat",
          "lon"
        ],
        "title": "PoiCreate",
        "type": "object"
      },
      "PointResource": {
        "properties": {
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "PointResource",
        "type": "object"
      },
      "ProjectCreate": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectCreate",
        "type": "object"
      },
      "ProjectResource": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "offroad_speed_kmh": {
            "title": "Offroad Speed Kmh",
            "type": "number"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "revision",
          "offroad_speed_kmh"
        ],
        "title": "ProjectResource",
        "type": "object"
      },
      "ProjectUpdate": {
        "description": "The project's settings. The speed rule (above 0, finite) is the domain's, so it is not checked here.",
        "properties": {
          "offroad_speed_kmh": {
            "title": "Offroad Speed Kmh",
            "type": "number"
          }
        },
        "required": [
          "offroad_speed_kmh"
        ],
        "title": "ProjectUpdate",
        "type": "object"
      },
      "TotalsResource": {
        "description": "The plan's road, off-road and total driving (FR-6.2), in km and seconds, unrounded: rounding is the web's.",
        "properties": {
          "offroad_km": {
            "title": "Offroad Km",
            "type": "number"
          },
          "offroad_s": {
            "title": "Offroad S",
            "type": "number"
          },
          "road_km": {
            "title": "Road Km",
            "type": "number"
          },
          "road_s": {
            "title": "Road S",
            "type": "integer"
          },
          "total_km": {
            "title": "Total Km",
            "type": "number"
          },
          "total_s": {
            "title": "Total S",
            "type": "number"
          }
        },
        "required": [
          "road_km",
          "road_s",
          "offroad_km",
          "offroad_s",
          "total_km",
          "total_s"
        ],
        "title": "TotalsResource",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Overland Route Planner",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "api_health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Api Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Api Health"
      }
    },
    "/api/plan-jobs/{job_id}": {
      "get": {
        "description": "`plan_run_id` stays null until the run is stored. 404 `not_found` for an unknown or expired id.",
        "operationId": "plan_job_api_plan_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanJobResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "not_found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Plan Job"
      }
    },
    "/api/plan-runs/{plan_run_id}": {
      "get": {
        "description": "The stops in order, track stops with their entry and exit, and the unrounded totals; a Failed run has no\nstops and no totals and names its reason; a run stored before the totals were shows `totals` null.",
        "operationId": "plan_run_api_plan_runs__plan_run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "plan_run_id",
            "required": true,
            "schema": {
              "title": "Plan Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanRunDetailResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "not_found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Plan Run"
      }
    },
    "/api/plan-runs/{plan_run_id}/export.gpx": {
      "get": {
        "description": "Changes nothing. 404 `not_found` for an unknown run; 422 `validation_error` for a Failed run or when a\ntrack's stored points are not the ones the run recorded. A sync handler, so a big track never holds up the\nevent loop. The file name is safe to quote: `run_file_name` answers only `[a-z0-9-]`, a run number and `.gpx`.",
        "operationId": "export_gpx_api_plan_runs__plan_run_id__export_gpx_get",
        "parameters": [
          {
            "in": "path",
            "name": "plan_run_id",
            "required": true,
            "schema": {
              "title": "Plan Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/gpx+xml": {}
            },
            "description": "The GPX file"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "not_found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Export Gpx"
      }
    },
    "/api/projects": {
      "get": {
        "operationId": "list_projects_api_projects_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectResource"
                  },
                  "title": "Response List Projects Api Projects Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "not_found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "List Projects"
      },
      "post": {
        "operationId": "create_project_api_projects_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "not_found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Create Project"
      }
    },
    "/api/projects/{project_id}": {
      "get": {
        "operationId": "open_project_api_projects__project_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "not_found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Open Project"
      },
      "patch": {
        "description": "Sets the off-road speed (one more revision); 0 or less, or not finite, answers 422 and nothing changes.",
        "operationId": "update_project_api_projects__project_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "not_found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Update Project"
      }
    },
    "/api/projects/{project_id}/anchors": {
      "put": {
        "description": "Replaces Start and End; `null` leaves one unset. Unknown ids answer 404; a track or another project's item\n422; nothing changes.",
        "operationId": "set_anchors_api_projects__project_id__anchors_put",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnchorsChoice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "not_found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Set Anchors"
      }
    },
    "/api/projects/{project_id}/items": {
      "get": {

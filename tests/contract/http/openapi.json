{
  "components": {
    "schemas": {
      "AnchorsChoice": {
        "description": "The Start and End item ids (HC-2): POIs of the project, the same one for a round trip. Both required in 01a.",
        "properties": {
          "end_item_id": {
            "title": "End Item Id",
            "type": "string"
          },
          "start_item_id": {
            "title": "Start Item Id",
            "type": "string"
          }
        },
        "required": [
          "start_item_id",
          "end_item_id"
        ],
        "title": "AnchorsChoice",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "Every non-2xx answer under /api (D183).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ItemResource": {
        "description": "A catalog item (D107): `location` for a POI; `entry`, `exit` and `length_m` for a track; others null.",
        "properties": {
          "anchor": {
            "anyOf": [
              {
                "enum": [
                  "start",
                  "end",
                  "start_end"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchor"
          },
          "entry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "included": {
            "title": "Included",
            "type": "boolean"
          },
          "length_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Length M"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "enum": [
              "track",
              "poi"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "included",
          "anchor",
          "location",
          "entry",
          "exit",
          "length_m"
        ],
        "title": "ItemResource",
        "type": "object"
      },
      "PlanJobAccepted": {
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "title": "PlanJobAccepted",
        "type": "object"
      },
      "PlanJobResource": {
        "description": "The poll payload (brief \u00a75): the subset slice 01b fills; later fields are additive.",
        "properties": {
          "elapsed_s": {
            "title": "Elapsed S",
            "type": "number"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "plan_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Run Id"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "state": {
            "enum": [
              "queued",
              "computing_legs",
              "solving",
              "finalising",
              "done",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "reason",
          "message",
          "plan_run_id",
          "elapsed_s"
        ],
        "title": "PlanJobResource",
        "type": "object"
      },
      "PlanRunDetailResource": {
        "description": "A plan run with its ordered stops; a Failed run has none and names its `failure_reason`.",
        "properties": {
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/PlanStopResource"
            },
            "title": "Stops",
            "type": "array"
          }
        },
        "required": [
          "id",
          "project_id",
          "number",
          "status",
          "failure_reason",
          "stops"
        ],
        "title": "PlanRunDetailResource",
        "type": "object"
      },
      "PlanRunResource": {
        "description": "A numbered plan run; a job still running has none.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ready",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "status"
        ],
        "title": "PlanRunResource",
        "type": "object"
      },
      "PlanStopResource": {
        "description": "One stop of the itinerary: the first has no road leg; a track shows its entry and exit (HC-1), a POI none.",
        "properties": {
          "entry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PointResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "leg_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leg Km"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "enum": [
              "poi",
              "track"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "leg_km",
          "entry",
          "exit"
        ],
        "title": "PlanStopResource",
        "type": "object"
      },
      "PoiCreate": {
        "description": "A place by decimal degrees. The ranges are the domain's rule (D151 reasons), so they are not checked here.",
        "properties": {
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "lat",
          "lon"
        ],
        "title": "PoiCreate",
        "type": "object"
      },
      "PointResource": {
        "properties": {
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "PointResource",
        "type": "object"
      },
      "ProjectCreate": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectCreate",
        "type": "object"
      },
      "ProjectResource": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "revision"
        ],
        "title": "ProjectResource",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Overland Route Planner",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "api_health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Api Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Api Health"
      }
    },
    "/api/plan-jobs/{job_id}": {
      "get": {
        "description": "`plan_run_id` stays null until the run is stored. 404 `not_found` for an unknown or expired id.",
        "operationId": "plan_job_api_plan_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanJobResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "not_found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "validation_error"
          }
        },
        "summary": "Plan Job"
      }
    },

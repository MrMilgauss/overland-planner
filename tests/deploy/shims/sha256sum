#!/usr/bin/env python3
"""Fake `sha256sum` (macOS has none; the helper container's busybox one is emulated by the docker shim): FILE...
prints `<hex>  <name>` per file, like coreutils."""

import hashlib
import sys
from pathlib import Path

for name in sys.argv[1:]:
    print(f"{hashlib.sha256(Path(name).read_bytes()).hexdigest()}  {name}")
